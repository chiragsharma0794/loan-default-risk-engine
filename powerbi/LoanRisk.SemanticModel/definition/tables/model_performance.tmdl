	partition model_performance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceFolder & "/model_performance.csv"), [Delimiter=",", Columns=21, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"model", type text}, {"is_final", Int64.Type}, {"split", type text}, {"loan_count", Int64.Type}, {"default_count", Int64.Type}, {"roc_auc", type number}, {"average_precision", type number}, {"log_loss", type number}, {"brier_score", type number}, {"threshold", type number}, {"threshold_rule", type text}, {"precision", type number}, {"recall", type number}, {"predicted_positive_rows", Int64.Type}, {"mean_probability", type number}, {"observed_default_rate", type number}, {"mean_prediction_minus_default_rate", type number}, {"tn", Int64.Type}, {"fp", Int64.Type}, {"fn", Int64.Type}, {"tp", Int64.Type}}, "en-US")
				in
				    Typed

