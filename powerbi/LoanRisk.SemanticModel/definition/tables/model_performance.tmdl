table model_performance
	lineageTag: 942bd894-7f05-447a-93af-2e2925d3f97a

	measure 'Model ROC-AUC' = SELECTEDVALUE('model_performance'[roc_auc])
		formatString: 0.0000
		lineageTag: d3dc44db-13ac-425c-9c1b-35f32e678444

	measure 'Model Average Precision' = SELECTEDVALUE('model_performance'[average_precision])
		formatString: 0.0000
		lineageTag: 54c638b8-f74a-46b8-9ad8-5a2f28c25865

	measure 'Model Log Loss' = SELECTEDVALUE('model_performance'[log_loss])
		formatString: 0.0000
		lineageTag: 71f9674d-99e1-4b17-9a6f-a321e3f3fc99

	measure 'Model Brier Score' = SELECTEDVALUE('model_performance'[brier_score])
		formatString: 0.0000
		lineageTag: 4aea2c73-7b58-4a46-bc4d-7c1a4c1ac736

	measure 'Final ROC-AUC' =
			CALCULATE([Model ROC-AUC], REMOVEFILTERS('model_performance'),
			              'model_performance'[is_final] = 1)
		formatString: 0.0000
		lineageTag: 733cb2dd-3151-4525-8b16-eeeaf013da7b

	measure 'Baseline ROC-AUC' =
			CALCULATE([Model ROC-AUC], REMOVEFILTERS('model_performance'),
			              'model_performance'[model] = "baseline")
		formatString: 0.0000
		lineageTag: a294efb4-7b9a-4998-a5e0-238569003340

	measure 'ROC-AUC Gain' = [Final ROC-AUC] - [Baseline ROC-AUC]
		formatString: 0.0000
		lineageTag: 74b0a2c7-2a2e-48f4-b653-e51dcae350a5

	measure 'Final Threshold' =
			CALCULATE(SELECTEDVALUE('model_performance'[threshold]),
			              REMOVEFILTERS('model_performance'), 'model_performance'[is_final] = 1)
		formatString: 0.0
		lineageTag: f98e1800-56e6-4333-b602-56c70888ddb5

	measure 'Final Recall' =
			CALCULATE(SELECTEDVALUE('model_performance'[recall]),
			              REMOVEFILTERS('model_performance'), 'model_performance'[is_final] = 1)
		formatString: 0.00%
		lineageTag: 2578a41b-8526-4426-a9d4-d0f7daf12bb6

	measure 'Final Precision Label' =
			VAR PrecisionValue =
			        CALCULATE(SELECTEDVALUE('model_performance'[precision]),
			                  REMOVEFILTERS('model_performance'), 'model_performance'[is_final] = 1)
			    RETURN IF(ISBLANK(PrecisionValue), "Undefined", FORMAT(PrecisionValue, "0.00%"))
		lineageTag: 28e11928-8acf-4ced-b2fc-81a1cf1f2bd9

	measure 'Final TN' =
			CALCULATE(SELECTEDVALUE('model_performance'[tn]),
			              REMOVEFILTERS('model_performance'), 'model_performance'[is_final] = 1)
		formatString: #,0
		lineageTag: 84672346-b0ae-4ad8-976a-132c2038470d

	measure 'Final FP' =
			CALCULATE(SELECTEDVALUE('model_performance'[fp]),
			              REMOVEFILTERS('model_performance'), 'model_performance'[is_final] = 1)
		formatString: #,0
		lineageTag: ff85771c-001c-46eb-b90e-ca2f33972fa3

	measure 'Final FN' =
			CALCULATE(SELECTEDVALUE('model_performance'[fn]),
			              REMOVEFILTERS('model_performance'), 'model_performance'[is_final] = 1)
		formatString: #,0
		lineageTag: 5f204f00-39f6-4e23-beec-f26f731a04a0

	measure 'Final TP' =
			CALCULATE(SELECTEDVALUE('model_performance'[tp]),
			              REMOVEFILTERS('model_performance'), 'model_performance'[is_final] = 1)
		formatString: #,0
		lineageTag: 6d9a17e7-ba8a-4fe4-b32f-74a1b2512683

