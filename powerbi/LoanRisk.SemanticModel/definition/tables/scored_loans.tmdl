		sourceColumn: state

	column 'Purpose label' = SUBSTITUTE([purpose], "_", " ")
		dataType: string
		lineageTag: 87ac04e5-6da9-4fbf-ac57-7d0ec0ee7676
		summarizeBy: none

	partition scored_loans = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceFolder & "/scored_loans.csv"), [Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"source_row", Int64.Type}, {"actual_default", Int64.Type}, {"predicted_probability", type number}, {"predicted_class", Int64.Type}, {"risk_band_id", Int64.Type}, {"risk_band", type text}, {"issue_month", type date}, {"term_months", Int64.Type}, {"loan_amount", type number}, {"annual_income", type number}, {"interest_rate_pct", type number}, {"grade", type text}, {"sub_grade", type text}, {"purpose", type text}, {"home_ownership", type text}, {"state", type text}}, "en-US")
				in
				    Typed

