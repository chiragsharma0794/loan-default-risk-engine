table scored_loans
	lineageTag: e16600ba-0b25-41ee-befe-7e037333861c

	measure 'Total Loans' = COALESCE(COUNTROWS('scored_loans'), 0)
		formatString: #,0
		lineageTag: c8a68cf0-7baf-49b8-b23d-e83d2c6cac3c

	measure 'Actual Defaults' = COALESCE(SUM('scored_loans'[actual_default]), 0)
		formatString: #,0
		lineageTag: 430a9ecc-40bf-44e5-a556-0b1fa8470bd3

	measure 'Default Rate' = DIVIDE([Actual Defaults], [Total Loans])
		formatString: 0.00%
		lineageTag: f4d3a928-97c4-4d67-ac76-561c3f44c443

	measure 'Average Predicted Probability' = AVERAGE('scored_loans'[predicted_probability])
		formatString: 0.00%
		lineageTag: 4656f04f-82e6-4980-b756-be40fb2d972d

	measure 'Loans at 20% or Above' = CALCULATE([Total Loans], KEEPFILTERS('risk_bands'[risk_band_id] = 4))
		formatString: #,0
		lineageTag: c7658c69-9e15-45e5-b33a-86ba4857e8fb

	measure 'Share at 20% or Above' = DIVIDE([Loans at 20% or Above], [Total Loans])
		formatString: 0.00%
		lineageTag: 7a3260ca-9cb3-4f78-8293-de40482b8178

	measure 'Average Loan Amount' = AVERAGE('scored_loans'[loan_amount])
		formatString: #,0
		lineageTag: 99c40262-137f-4c6b-ab44-5fe3dec1551e

	measure 'Average Annual Income' = AVERAGE('scored_loans'[annual_income])
		formatString: #,0
		lineageTag: 3cfce20f-258d-4c78-98c3-203593dfbb5a

	column source_row
		dataType: int64
		isHidden
		lineageTag: bc7dbc1c-0055-4304-be18-1dbc70c805aa
		summarizeBy: none
		sourceColumn: source_row

	column actual_default
		dataType: int64
		lineageTag: d1a1f68b-743b-4e5a-b330-b849aaad673a
		summarizeBy: none
		sourceColumn: actual_default

	column predicted_probability
		dataType: double
		lineageTag: 18938e7e-f479-4300-a240-3868331cd9fa
		summarizeBy: none
		sourceColumn: predicted_probability

	column predicted_class
		dataType: int64
		isHidden
