table risk_band_summary
	isHidden
	lineageTag: 57a1fbd7-7782-4a8a-b574-84a82b109739

	column risk_band_id
		dataType: int64
		isHidden
		lineageTag: 7c36888d-6476-4764-9ef2-7a19daa3c3db
		summarizeBy: none
		sourceColumn: risk_band_id

	column loan_count
		dataType: int64
		lineageTag: b175a70f-5a37-4709-9841-738027d41000
		summarizeBy: none
		sourceColumn: loan_count

	column default_count
		dataType: int64
		lineageTag: 064460ec-bbc4-4963-9242-1d4d7696c692
		summarizeBy: none
		sourceColumn: default_count

	column default_rate
		dataType: double
		lineageTag: b40232c7-a280-4016-849b-2d8455da8396
		summarizeBy: none
		sourceColumn: default_rate

	column avg_predicted_probability
		dataType: double
		lineageTag: b6db623c-b02d-44af-99c8-0d1930848224
		summarizeBy: none
		sourceColumn: avg_predicted_probability

	column risk_band
		dataType: string
