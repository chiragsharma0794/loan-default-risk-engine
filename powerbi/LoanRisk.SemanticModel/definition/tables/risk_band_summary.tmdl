		sortByColumn: risk_band_id

	partition risk_band_summary = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(SourceFolder & "/risk_band_summary.csv"), [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Blanks = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Blanks, {{"risk_band_id", Int64.Type}, {"loan_count", Int64.Type}, {"default_count", Int64.Type}, {"default_rate", type number}, {"avg_predicted_probability", type number}, {"risk_band", type text}}, "en-US")
				in
				    Typed

